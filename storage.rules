rules_version = '2';
// The Dugout — Storage rules (videos and photos). Paste into Firebase console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isStaff() {
      return signedIn() && (request.auth.token.email.lower() in ['ocker@prepbaseball.com']
        || firestore.exists(/databases/(default)/documents/access/$(request.auth.token.email.lower())));
    }
    match /media/{file} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isStaff();
    }
  }
}
